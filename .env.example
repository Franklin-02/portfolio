# -----------------------------------------------------------------------------
# Portfolio configuration
#
# Copy this file to `.env` (local development) or `.env.production` (builds),
# or set the same variables in your hosting provider's dashboard.
# Every variable is optional. Nothing here is secret: VITE_* values are
# embedded in the public JavaScript bundle, so never put private keys in them.
# -----------------------------------------------------------------------------

# Absolute URL of the deployed site, without a trailing slash.
# Enables the canonical URL, og:url, absolute social-image URL and sitemap.xml.
VITE_SITE_URL=https://your-domain.com

# Base path, only when the site is served from a sub-folder.
# GitHub Pages project sites need the repository name: /your-repo-name/
# Leave as / for Vercel, Netlify and custom domains.
VITE_BASE_PATH=/

# Resume PDF filename. Put the file in public/resume/ with exactly this name.
# The "Download Resume" buttons switch on automatically once the file exists.
VITE_RESUME_FILE=Franklin-Selvaraj-M-Resume.pdf

# Contact form backend. Leave empty to use the built-in mailto fallback
# (the visitor's email app opens with the message pre-filled).
#   Formspree : https://formspree.io/f/your-form-id
#   Web3Forms : https://api.web3forms.com/submit   (also set the access key below)
#   Getform   : https://getform.io/f/your-form-id
VITE_CONTACT_ENDPOINT=

# Public access key, only for providers that require one (Web3Forms).
VITE_CONTACT_ACCESS_KEY=

# Plausible Analytics (privacy-friendly, cookieless). Leave empty to disable.
# Set to the domain you registered in Plausible, e.g. your-domain.com
VITE_PLAUSIBLE_DOMAIN=

# Optional: custom Plausible script URL (self-hosted or proxied).
VITE_PLAUSIBLE_SRC=
